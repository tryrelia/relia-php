{
    "name": "tryrelia/relia",
    "description": "Relia for PHP and Laravel: requests, errors, database queries, outgoing calls, queue jobs and logs, explained in plain words. Pure PHP, no extension.",
    "type": "library",
    "license": "MIT",
    "keywords": ["observability", "monitoring", "apm", "laravel", "opentelemetry", "error tracking", "mcp"],
    "homepage": "https://tryrelia.com",
    "support": { "email": "support@tryrelia.com" },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "ext-curl": "Faster export (falls back to PHP streams without it)",
        "ext-zlib": "Gzip-compressed export"
    },
    "autoload": {
        "psr-4": { "Relia\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Relia\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Relia\\Laravel\\ReliaServiceProvider"]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
